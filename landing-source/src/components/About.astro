---
import { about } from '../data/site';
const paragraphs = about.split('\n\n');
---

<section id="about" class="py-20 px-6 border-t border-hairline">
  <div class="max-w-3xl mx-auto grid sm:grid-cols-[140px_1fr] gap-8">
    <p class="eyebrow">§ 01 — About</p>
    <div class="space-y-4 text-ink leading-relaxed">
      {paragraphs.map((p) => <p>{p}</p>)}
    </div>
  </div>
</section>
