---
import type { Content } from '../data/types';

interface Props {
  content: Content;
}

const { content: t } = Astro.props;
---

<section id="experience" class="py-20 px-6 border-t border-hairline">
  <div class="max-w-4xl mx-auto">
    <div class="grid sm:grid-cols-[140px_1fr] gap-8">
      <p class="eyebrow">{t.experienceEyebrow}</p>
      <div>
        <div class="flex justify-end mb-6">
          <a href={t.profile.linkedin} class="font-mono text-xs text-blueprint hover:text-ink transition-colors underline decoration-hairline underline-offset-4">
            {t.experienceLinkedinCta}
          </a>
        </div>
        <div class="space-y-0">
          {t.experience.map((item, i) => (
            <div class="grid sm:grid-cols-[50px_100px_1fr] gap-3 sm:gap-6 border-t border-hairline py-5 first:border-t-0 first:pt-0">
              <p class="font-mono text-xs text-blueprint pt-0.5">{String(i + 1).padStart(2, '0')}</p>
              <p class="font-mono text-xs text-ink-muted pt-0.5">{item.period}</p>
              <div>
                <h3 class="font-display text-lg text-ink leading-snug">{item.role}</h3>
                <p class="text-blueprint text-sm mb-1">{item.org}</p>
                <p class="text-ink-muted text-sm leading-relaxed">{item.summary}</p>
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </div>
</section>
