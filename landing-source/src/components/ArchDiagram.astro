---
// Diagrama de arquitectura estilo blueprint — signature element del hero.
// Nodo central = Carlos, nodos periféricos = dominios técnicos que dirige.
---

<svg viewBox="0 0 480 480" class="w-full h-full" role="img" aria-label="Diagram showing Carlos at the center, connected to Cloud Foundation, Migration, Modernization, and Delivery domains">
  <defs>
    <marker id="dot" markerWidth="6" markerHeight="6" refX="3" refY="3">
      <circle cx="3" cy="3" r="2.5" fill="#1E3A5F" />
    </marker>
  </defs>

  <!-- líneas de conexión -->
  <g stroke="#1E3A5F" stroke-width="1.25" fill="none" opacity="0.55">
    <path d="M240 240 L240 90" marker-end="url(#dot)" />
    <path d="M240 240 L390 165" marker-end="url(#dot)" />
    <path d="M240 240 L390 315" marker-end="url(#dot)" />
    <path d="M240 240 L240 390" marker-end="url(#dot)" />
    <path d="M240 240 L90 315" marker-end="url(#dot)" />
    <path d="M240 240 L90 165" marker-end="url(#dot)" />
  </g>

  <!-- nodo central -->
  <g>
    <rect x="180" y="205" width="120" height="70" fill="#FAFAF7" stroke="#1C1E21" stroke-width="1.5" />
    <text x="240" y="234" text-anchor="middle" font-family="Fraunces, serif" font-size="15" fill="#1C1E21">Carlos</text>
    <text x="240" y="252" text-anchor="middle" font-family="IBM Plex Mono, monospace" font-size="9" fill="#5A5F66" letter-spacing="0.5">TPM / AWS SA-P</text>
  </g>

  <!-- nodos periféricos -->
  <g font-family="IBM Plex Mono, monospace" font-size="10" fill="#1C1E21">
    <g>
      <rect x="180" y="55" width="120" height="42" fill="#FAFAF7" stroke="#1E3A5F" stroke-width="1" />
      <text x="240" y="80" text-anchor="middle">Cloud Foundation</text>
    </g>
    <g>
      <rect x="330" y="130" width="130" height="42" fill="#FAFAF7" stroke="#1E3A5F" stroke-width="1" />
      <text x="395" y="155" text-anchor="middle">Migration</text>
    </g>
    <g>
      <rect x="330" y="285" width="130" height="42" fill="#FAFAF7" stroke="#1E3A5F" stroke-width="1" />
      <text x="395" y="310" text-anchor="middle">Modernization</text>
    </g>
    <g>
      <rect x="180" y="355" width="120" height="42" fill="#FAFAF7" stroke="#1E3A5F" stroke-width="1" />
      <text x="240" y="380" text-anchor="middle">DR &amp; Resilience</text>
    </g>
    <g>
      <rect x="10" y="285" width="120" height="42" fill="#FAFAF7" stroke="#1E3A5F" stroke-width="1" />
      <text x="70" y="310" text-anchor="middle">Serverless</text>
    </g>
    <g>
      <rect x="10" y="130" width="120" height="42" fill="#FAFAF7" stroke="#1E3A5F" stroke-width="1" />
      <text x="70" y="155" text-anchor="middle">Delivery Mgmt</text>
    </g>
  </g>
</svg>
