---
import { productionProjects, personalProjects } from '../data/site';
import ProjectCard from './ProjectCard.astro';
---

<section id="projects" class="py-20 px-6 border-t border-hairline">
  <div class="max-w-4xl mx-auto">
    <div class="grid sm:grid-cols-[140px_1fr] gap-8">
      <p class="eyebrow">§ 03 — Delivery &amp; Portfolio</p>
      <div>
        <div class="mb-14">
          <h3 class="font-display text-2xl text-ink mb-1">Project Management Experience</h3>
          <p class="text-sm text-ink-muted mb-8">
            Project delivery experience in real enterprise environments.
          </p>
          <div class="grid sm:grid-cols-2 gap-x-10 gap-y-8">
            {productionProjects.map((p, i) => <ProjectCard project={p} index={i} />)}
          </div>
        </div>

        <div id="portfolio">
          <h3 class="font-display text-2xl text-ink mb-1">Technical Portfolio</h3>
          <p class="text-sm text-ink-muted mb-8">
            Self-designed architecture — full ownership of design decisions, tradeoffs, and implementation.
          </p>

          {personalProjects.length > 0 ? (
            <div class="grid sm:grid-cols-2 gap-x-10 gap-y-8">
              {personalProjects.map((p, i) => <ProjectCard project={p} index={i} />)}
            </div>
          ) : (
            <div class="border-t border-dashed border-hairline pt-5">
              <p class="font-mono text-sm text-ink-muted">— New personal projects in progress. Coming soon.</p>
            </div>
          )}
        </div>
      </div>
    </div>
  </div>
</section>
