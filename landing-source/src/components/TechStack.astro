---
import type { Content } from '../data/types';

interface Props {
  content: Content;
}

const { content: t } = Astro.props;
---

<section id="stack" class="py-20 px-6 border-t border-hairline">
  <div class="max-w-4xl mx-auto">
    <div class="grid sm:grid-cols-[140px_1fr] gap-8">
      <p class="eyebrow">{t.techStackEyebrow}</p>
      <div>
        <div class="grid grid-cols-2 sm:grid-cols-3 gap-x-8 gap-y-4 font-mono text-sm">
          {t.techStack.map((tech) => (
            <div class="border-l-2 border-hairline pl-3 py-0.5">
              <p class="text-ink">{tech.name}</p>
              <p class="text-ink-muted text-xs mt-0.5">{tech.category}</p>
            </div>
          ))}
        </div>
      </div>
    </div>
  </div>
</section>
