---
import { education, certifications } from '../data/site';
---

<section id="education" class="py-20 px-6 border-t border-hairline">
  <div class="max-w-4xl mx-auto grid sm:grid-cols-[140px_1fr] gap-8">
    <p class="eyebrow">§ 05 — Education</p>
    <div class="grid sm:grid-cols-2 gap-12">
      <div>
        <h3 class="font-display text-xl text-ink mb-5">Degrees</h3>
        <div class="space-y-5">
          {education.map((e) => (
            <div class="border-t border-hairline pt-3">
              <p class="text-ink">{e.degree}</p>
              <p class="text-ink-muted text-sm">{e.school}</p>
              <p class="font-mono text-xs text-ink-muted mt-1">{e.period}</p>
            </div>
          ))}
        </div>
      </div>

      <div>
        <h3 class="font-display text-xl text-ink mb-5">Certifications</h3>
        <ul class="space-y-0">
          {certifications.map((c) => (
            <li class="flex items-baseline justify-between border-t border-hairline py-3 text-sm">
              <span class="text-ink">{c.name}</span>
              <span class="font-mono text-xs text-seal ml-3 shrink-0">{c.year}</span>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </div>
</section>
